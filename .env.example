# MusaTech Configuration Template
# Ce fichier sert d'exemple uniquement. Aucun secret ni clé privée réelle ne doit être consigné ici.

# -----------------------------------------------------------------------------
# Configuration Côté Serveur (Vercel Serverless Functions /api/devis)
# À renseigner dans le tableau de bord Vercel (Settings > Environment Variables)
# -----------------------------------------------------------------------------

# URL de connexion PostgreSQL managée (Neon.tech ou Supabase) avec pooler serverless
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clé API Resend pour l'envoi d'emails transactionnels (ex: re_...)
RESEND_API_KEY="votre_cle_api_resend_ici"

# Expéditeur des emails (utiliser un domaine vérifié sur Resend ou l'expéditeur de test par défaut)
EMAIL_FROM="MusaTech <contact@musatech.tech>"

# Destinataire interne pour les nouvelles opportunités commerciales
NOTIFICATION_EMAIL_TO="musadev27@gmail.com"

# -----------------------------------------------------------------------------
# Configuration Côté Client (Variables publiques préfixées par VITE_)
# -----------------------------------------------------------------------------

# Endpoint optionnel pour le formulaire client (défaut automatique : /api/devis)
VITE_API_QUOTE_ENDPOINT="/api/devis"

# Télémétrie optionnelle Vercel Analytics (automatique en déploiement Vercel)
# VITE_VERCEL_ANALYTICS_ID=
